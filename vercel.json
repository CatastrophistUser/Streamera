{
    "rewrites": [
        {
            "source": "/tmdb/:path*",
            "destination": "https://api.themoviedb.org/3/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        }
    ]
}